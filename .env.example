# PostgreSQL connection string. Locally, point this at any Postgres
# instance (a local server works fine for dev too). In production
# (Railway), set this in the service's Variables tab — if the Postgres
# database is a service in the same Railway project, reference it with
# ${{Postgres.DATABASE_URL}} instead of pasting the value directly, so it
# always tracks the real database automatically.
DATABASE_URL="postgresql://user:password@localhost:5432/intelligence_app"

# Optional: a shared secret for the weekly-rankings cron endpoint (see
# .github/workflows/weekly-rankings-cron.yml and
# app/api/cron/weekly-rankings/route.ts). If set here, set the exact same
# value as the CRON_SECRET repository secret in GitHub so the scheduled
# workflow's request is authorized. Leave unset (and omit the GitHub
# secret) to leave that endpoint open/unauthenticated — fine for a
# low-stakes internal job, but set this if you'd rather not.
CRON_SECRET=""

# Vercel Blob read-write token — ONLY needed if you want the Games tab's
# optional game-video upload feature (see components/games/
# VideoUploadPanel.tsx). This is a Vercel-specific storage product and
# still requires a Vercel account/Blob store even when the app itself runs
# elsewhere (e.g. Railway) — it is NOT part of the Railway migration.
# Leave this unset to leave video upload simply unavailable (the rest of
# the app works fully without it); see that component's
# describeUploadError() for the exact message a coach would see if they
# tried to use it without this set.
BLOB_READ_WRITE_TOKEN=""

