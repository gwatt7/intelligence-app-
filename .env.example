# PostgreSQL connection string. Locally, point this at any Postgres
# instance (a local server, or a free Neon/Vercel Postgres branch works
# fine for dev too). In production (Vercel), set this in the project's
# Environment Variables to the pooled connection string Vercel/Neon gives
# you when you add a Postgres database to the project.
DATABASE_URL="postgresql://user:password@localhost:5432/intelligence_app"

# --- Sign-in for the UWS Men's Hockey workspace -----------------------------
# All three are required. Until they are set, the login screen shows
# "Sign-in isn't set up yet" and nobody can reach the dashboard.
# In production, set them in Vercel → Project → Settings → Environment Variables.
NORTHSTAR_LOGIN_USERNAME="coach@example.com"
NORTHSTAR_LOGIN_PASSWORD="choose-a-long-unique-password"
# Random string, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Changing it signs everyone out.
NORTHSTAR_SESSION_SECRET=""
